# Copy to .env and fill in. .env is gitignored.

# Public hostname Caddy will obtain a Let's Encrypt cert for.
# Must point to this VM's public IP (A / AAAA record).
DOMAIN=chat.example.com

# Master password for at-rest DB encryption. Generate with:
#   openssl rand -base64 32
# IMPORTANT: Losing this password means losing the DB permanently.
LLM_CHAT_MASTER_PASSWORD=change-me-to-a-long-random-string

# ─── Optional: OpenClaw ───────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=
