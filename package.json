{
  "name": "llm-chat",
  "private": true,
  "version": "0.0.1",
  "description": "Desktop LLM chat application with multi-provider support and MCP integration",
  "author": {
    "name": "Jukka-Pekka Lappalainen",
    "email": "jukka-pekka.lappalainen@sanoma.com"
  },
  "homepage": "https://github.com/jplappa/llm-chat",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "docker compose up -d && concurrently \"pnpm run dev:server\" \"pnpm run dev:client:wait\"",
    "dev:client": "vite",
    "dev:client:wait": "wait-on tcp:localhost:3001 && vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:electron": "docker compose up -d && concurrently \"pnpm run dev:server\" \"pnpm run dev:client:wait\" \"pnpm run dev:main\"",
    "dev:main": "pnpm run build:electron && wait-on http://localhost:5173 tcp:localhost:3001 && electron .",
    "build": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist": "pnpm run build && pnpm run build:electron && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.llmchat.app",
    "productName": "LLM Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*.ts",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      "docker-compose.yml",
      "searxng/settings.yml"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "zip"
      ],
      "category": "Development"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@modelcontextprotocol/**"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/google": "^3.0.62",
    "@ai-sdk/openai": "^3.0.52",
    "@aws-sdk/client-bedrock-runtime": "^3.1067.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.4.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/katex": "^0.16.8",
    "ai": "^6.0.158",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "mathjs": "^15.2.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "selfsigned": "^5.5.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  }
}
